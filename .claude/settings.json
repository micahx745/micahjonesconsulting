{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python314/python.exe C:/Users/micah/Code/micahjonesconsulting/product/playbook/hook-gate.py",
            "timeout": 30,
            "statusMessage": "check.py gate on playbook chapter"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-write-guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\" --source branch",
            "timeout": 10,
            "statusMessage": "worktree write guard (LESSONS #49)"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$HARNESS_ROLE\" = \"executor\" ] || exit 0; python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/executor-guard.py\"",
            "timeout": 10,
            "statusMessage": "executor guard (Harness v2 E1)"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$HARNESS_ROLE\" = \"executor\" ] && exit 0; f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/budget-gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 10,
            "statusMessage": "budget gate (Harness v2 B2)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/routing-reminder.py\"",
            "timeout": 15,
            "statusMessage": "AI routing reminder"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$HARNESS_ROLE\" = \"executor\" ] && exit 0; f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/budget-gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 10,
            "statusMessage": "budget line (Harness v2 B2)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm build:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec tsx:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sL http://localhost:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(python:*)"
    ]
  }
}
