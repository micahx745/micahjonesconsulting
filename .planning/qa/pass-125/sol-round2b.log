+        grid-template-columns: repeat(${viewport.columns}, ${displayWidth}px);
+        gap: ${gap}px;
+        align-items: start;
+      }
+      figure { margin: 0; width: ${displayWidth}px; }
+      figcaption {
+        padding: 7px 9px;
+        background: #333;
+        color: #fff;
+        font-size: 12px;
+        font-weight: 700;
+        line-height: 1;
+      }
