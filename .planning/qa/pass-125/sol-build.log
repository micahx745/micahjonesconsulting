+    results[String(width)][FULL_TIME.path] = fullTime;
+
+    expectEqual(`${width} /full-time h1 count`, fullTime.h1Count, 1);
+    expectEqual(`${width} /full-time h1 text`, fullTime.h1Text, FULL_TIME.h1);
