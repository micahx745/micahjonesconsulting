// Pass-124 homepage proposal capture. Usage:
//   node capture-home-v2.mjs <baseUrl> <A|B>
//
// Captures clean and annotated full-page screenshots at 390px and 1440px,
// and records axe-core serious/critical results from the clean page.
import { createRequire } from "node:module";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const require = createRequire("C:/tmp/p101tools/package.json");
const puppeteer = require("puppeteer-core");
const axeSource = fs.readFileSync(require.resolve("axe-core/axe.min.js"), "utf8");

const baseUrl = process.argv[2];
const variant = process.argv[3]?.toUpperCase();
if (!baseUrl || !["A", "B"].includes(variant)) {
  console.error("usage: node capture-home-v2.mjs <baseUrl> <A|B>");
  process.exit(1);
}

const outDir = path.dirname(fileURLToPath(import.meta.url));
const widths = [390, 1440];
const axeSummary = { variant, widths: {} };
const stage = async (label, action) => {
  try {
    return await action();
  } catch (error) {
    error.message = `${label}: ${error.message}`;
    throw error;
  }
};

const annotationSelectors = [
  "h1",
  ".cw-sub",
  ".cw-door--sell .cw-door__title",
  ".cw-door--sell .cw-door__body",
  "#cw-howiwork-title",
  ".cw-principles > li:nth-child(1) .cw-principle__name",
  ".cw-principles > li:nth-child(1) .cw-principle__artifact",
  ".cw-principles > li:nth-child(1) .cw-principle__text",
  ".cw-principles > li:nth-child(2) .cw-principle__name",
  ".cw-principles > li:nth-child(2) .cw-principle__artifact",
  ".cw-principles > li:nth-child(2) .cw-principle__text",
  ".cw-principles > li:nth-child(3) .cw-principle__name",
  ".cw-principles > li:nth-child(3) .cw-principle__artifact",
  ".cw-principles > li:nth-child(3) .cw-principle__text",
  ".cw-principles > li:nth-child(4) .cw-principle__name",
  ".cw-principles > li:nth-child(4) .cw-principle__artifact",
  ".cw-principles > li:nth-child(4) .cw-principle__text",
  ".cw-principles__more .cw-mlink",
  ".cw-big-link",
];
if (variant === "B") annotationSelectors.push(".cw-prose-lede.cw-reveal");

console.log("launch browser");
const browser = await stage("launch browser", () =>
  puppeteer.launch({
    executablePath: "C:/Program Files/Google/Chrome/Application/chrome.exe",
    headless: true,
    dumpio: true,
    args: ["--no-sandbox", "--disable-gpu"],
    ignoreDefaultArgs: ["--hide-scrollbars"],
  }),
);

try {
  for (const width of widths) {
    console.log(`begin ${variant} ${width}`);
    const page = await browser.newPage();
    await page.setViewport({ width, height: 900, deviceScaleFactor: 1 });
    await page.emulateMediaFeatures([
      { name: "prefers-reduced-motion", value: "reduce" },
    ]);
    console.log(`navigate ${variant} ${width}`);
    await stage(`navigate ${variant} ${width}`, () =>
      page.goto(baseUrl.replace(/\/$/, "") + "/", {
        waitUntil: "networkidle2",
      }),
    );
    console.log(`navigated ${variant} ${width}`);
    await stage(`settle ${variant} ${width}`, () => page.evaluate(async () => {
      await document.fonts.ready;
      const step = Math.max(1, Math.floor(window.innerHeight * 0.75));
      for (let y = 0; y < document.documentElement.scrollHeight; y += step) {
        window.scrollTo(0, y);
        await new Promise((resolve) => setTimeout(resolve, 25));
      }
      window.scrollTo(0, 0);
      await new Promise((resolve) => setTimeout(resolve, 250));
    }));
    console.log(`settled ${variant} ${width}`);

    await stage(`inject axe ${variant} ${width}`, () =>
      page.addScriptTag({ content: axeSource }),
    );
    console.log(`axe start ${variant} ${width}`);
    const axeResults = await stage(`run axe ${variant} ${width}`, () => page.evaluate(async () => {
      const results = await globalThis.axe.run(document);
      const summarize = (impact) => {
        const violations = results.violations.filter(
          (violation) => violation.impact === impact,
        );
        return {
          violations: violations.length,
          nodes: violations.reduce(
            (total, violation) => total + violation.nodes.length,
            0,
          ),
          rules: violations.map((violation) => ({
            id: violation.id,
            nodes: violation.nodes.length,
          })),
        };
      };
      return {
        serious: summarize("serious"),
        critical: summarize("critical"),
      };
    }));
    console.log(`axe complete ${variant} ${width}`);
    axeSummary.widths[String(width)] = axeResults;

    const cleanPath = path.join(outDir, `prop${variant}-${width}.png`);
    await page.screenshot({ path: cleanPath, fullPage: true });
    console.log(`wrote ${cleanPath}`);

    await page.evaluate((selectors) => {
      for (const selector of selectors) {
        const matches = document.querySelectorAll(selector);
        if (matches.length !== 1) {
          throw new Error(
            `annotation selector ${selector} matched ${matches.length} elements`,
          );
        }
        matches[0].setAttribute("data-p124-new", "");
      }
      const style = document.createElement("style");
      style.textContent = `
        [data-p124-new] {
          outline: 3px solid #1d6fd8 !important;
          outline-offset: -3px !important;
          position: relative !important;
        }
        [data-p124-new]::before {
          content: "NEW";
          position: absolute;
          z-index: 2147483647;
          top: 0;
          left: 0;
          padding: 2px 4px;
          background: #1d6fd8;
          color: #fff;
          font: 700 10px/1.2 Arial, sans-serif;
          letter-spacing: 0.04em;
        }
      `;
      document.head.appendChild(style);
    }, annotationSelectors);

    const annotatedPath = path.join(
      outDir,
      `prop${variant}-${width}-annotated.png`,
    );
    await page.screenshot({ path: annotatedPath, fullPage: true });
    console.log(`wrote ${annotatedPath}`);
    console.log(
      `axe ${variant} ${width}: serious=${axeResults.serious.violations} ` +
        `critical=${axeResults.critical.violations}`,
    );
    await page.close();
  }
} finally {
  await browser.close();
}

const axePath = path.join(outDir, `axe-${variant}.json`);
fs.writeFileSync(axePath, JSON.stringify(axeSummary, null, 2) + "\n");
console.log(`wrote ${axePath}`);


