+          ).length,
+        FULL_TIME.path,
+      ),
+    };
+    results[String(width)]["/"] = home;
+    expectEqual(`${width} / full-time links`, home.fullTimeLinks, 1);
+    expectEqual(
+      `${width} / primary-nav full-time links`,
