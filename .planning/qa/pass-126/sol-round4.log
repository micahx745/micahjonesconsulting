   48: async function scrollWholePage(page) {
   49:   let y = 0;
   50:   while (true) {
   51:     const dimensions = await page.evaluate(() => ({
   52:       height: window.innerHeight,
   53:       max:
   54:         Math.max(
   55:           document.body.scrollHeight,
   56:           document.documentElement.scrollHeight,
   57:         ) - window.innerHeight,
   58:     }));
   59:     if (y >= dimensions.max) {
   60:       await page.evaluate(
   61:         (target) => window.scrollTo(0, target),
   62:         dimensions.max,
   63:       );
   64:       await sleep(900);
   65:       await page.evaluate(() => window.scrollTo(0, 0));
   66:       await sleep(1000);
   67:       return;
   68:     }
   69:     await page.evaluate((target) => window.scrollTo(0, target), y);
   70:     await sleep(300);
   71:     y += dimensions.height * 0.75;
   72:   }
   73: }
