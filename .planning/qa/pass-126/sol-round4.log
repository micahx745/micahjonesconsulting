   75: async function axeCount(page, selector) {
   76:   debug(`axe start ${selector ?? "document"}`);
   77:   await page.addScriptTag({ content: axeSource });
   78:   const violations = await page.evaluate(async (contextSelector) => {
   79:     const context = contextSelector
   80:       ? document.querySelector(contextSelector)
   81:       : document;
   82:     if (!context) return null;
   83:     const results = await window.axe.run(context, {
   84:       resultTypes: ["violations"],
   85:     });
   86:     return results.violations
   87:       .filter((violation) => ["serious", "critical"].includes(violation.impact))
   88:       .map((violation) => ({
   89:         id: violation.id,
   90:         impact: violation.impact,
   91:         help: violation.help,
   92:         nodes: violation.nodes.map((node) => ({
   93:           target: node.target,
   94:           html: node.html,
   95:           failureSummary: node.failureSummary,
   96:         })),
   97:       }));
   98:   }, selector);
   99:   debug(`axe done ${selector ?? "document"}`);
  100:   return violations;
  101: }
