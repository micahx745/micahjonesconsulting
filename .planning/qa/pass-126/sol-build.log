+}
+[data-mode="cw"] .cw-hiw__step > div::before {
+  transition: transform .7s cubic-bezier(.16, 1, .3, 1) .15s;
+}
+[data-mode="cw"].cw-js-reveals .cw-hiw__step:not(.is-in) .cw-hiw__body {
