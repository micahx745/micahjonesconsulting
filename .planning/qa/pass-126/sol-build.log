+/* Pass-126 How I work (Fable pick: Sol's Marked-Up Proof on espresso) */
+[data-mode="cw"] .cw-hiw {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-areas:
+    "t"
+    "s"
+    "p"
+    "b"
+    "y"
+    "m";
+}
+[data-mode="cw"] .cw-hiw--services {
+  grid-template-areas:
+    "t"
+    "s"
+    "p"
+    "b"
+    "y"
+    "n"
+    "m";
+}
+[data-mode="cw"] .cw-hiw__list {
+  display: contents;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+[data-mode="cw"] .cw-hiw__title {
+  grid-area: t;
+  max-width: none;
+  margin-bottom: 40px;
+  color: inherit;
+  font-size: clamp(44px, 6.5vw, 92px);
+}
+[data-mode="cw"] .cw-hiw__step--scope {
+  grid-area: s;
+}
+[data-mode="cw"] .cw-hiw__step--plan {
+  grid-area: p;
+  margin-top: 56px;
+}
+[data-mode="cw"] .cw-hiw__step--build {
+  grid-area: b;
+  margin-top: 80px;
+}
+[data-mode="cw"] .cw-hiw__step--stay {
+  grid-area: y;
+  margin-top: 64px;
+}
+[data-mode="cw"] .cw-hiw__step--scope > div,
+[data-mode="cw"] .cw-hiw__step--stay > div {
+  margin-left: 0;
