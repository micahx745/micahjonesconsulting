+  line-height: 1.5;
+}
+[data-mode="cw"] .cw-hiw--services .cw-hiw__title {
+  max-width: none;
+  font-family: var(--font-cw-display);
+  font-size: clamp(38px, 4.6vw, 66px);
+  font-weight: 800;
+  line-height: 0.92;
+  letter-spacing: -0.025em;
+  text-transform: uppercase;
+}
+[data-mode="cw"] .cw-hiw--services .cw-hiw__head {
