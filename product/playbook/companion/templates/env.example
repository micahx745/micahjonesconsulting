# .env.example — every variable the code reads. No values here, ever.
# Commit this file. Set real values on the host, per environment,
# and remember: installed is not live until the next deploy.

# --- email ---
# Sends all transactional email. Sending-only key.
EMAIL_API_KEY=

# --- database ---
# Connection string. Production value lives ONLY on the host.
DATABASE_URL=

# --- payments (chapter 6: all four are PER MODE, test vs live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
