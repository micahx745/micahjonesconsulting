# Environment variables this codebase actually reads.
# Verified 2026-09-03 by grepping process.env across app/, lib/ and components/.
# Copy to .env.local and fill in. .env.local is gitignored and must stay so.
#
# THE STRIPE PREFIX TRAP, which cost three attempts on 2026-09-03. The dashboard
# shows three values that look alike and only one works here:
#   sk_   SECRET key       <- what STRIPE_SECRET_KEY wants
#   pk_   PUBLISHABLE key  <- browser-safe, useless server-side
#   mk_   the key's ID     <- an identifier, not a credential
# Production once held an mk_ value and every checkout returned
# StripeAuthenticationError. If Stripe rejects a key, CHECK THE PREFIX FIRST;
# the error text names the problem explicitly.

# ---- Stripe -----------------------------------------------------------------
# LOCAL AND PREVIEW MUST USE TEST MODE. The live key belongs in Vercel
# Production only - a live key here means `pnpm dev` can charge real cards.
# Test secret: https://dashboard.stripe.com/test/apikeys -> Reveal test key
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. PER-MODE: the test secret is NOT the live one.
# Locally run:  stripe listen --forward-to localhost:3000/api/stripe/webhook
# and paste what it prints. Without this the webhook rejects every event, so a
# payment succeeds and NO kickoff email is ever sent - a silent failure.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Email ------------------------------------------------------------------
# Contact form, beta and playbook signups, the booking invite, and the package
# kickoff (book PDF + companion ZIP attached). Without it the webhook still
# fires and the delivery code still runs, but nothing arrives.
# https://resend.com/api-keys
RESEND_API_KEY=re_...

# ---- Contact archive --------------------------------------------------------
# Server-side insert of contact submissions only. No client SDK, no anon key.
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Booking availability (optional) ----------------------------------------
# Private ICS feed used to grey out busy slots on /book. Fails OPEN: without it
# booking still works, it just cannot see existing calendar events. Treat the
# URL as a credential - anyone holding it can read the calendar.
BOOKING_CAL_ICS_URL=
